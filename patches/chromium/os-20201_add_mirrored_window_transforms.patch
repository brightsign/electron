       (transform == gfx::OVERLAY_TRANSFORM_FLIP_HORIZONTAL)) {
     if (is_original_buffer && (format_fourcc == DRM_FORMAT_NV12 ||
                                format_fourcc == DRM_FORMAT_P010)) {
