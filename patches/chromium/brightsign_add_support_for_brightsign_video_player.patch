+WebMediaPlayer::LoadTiming WebMediaPlayerBrightsign::Load(
+    LoadType type,
+    const WebMediaPlayerSource& source,
+    CorsMode cors,
+    bool is_cache_disabled) {
+  VLOG(1) << __func__;
