--- a/cc/trees/property_tree.cc
+++ b/cc/trees/property_tree.cc
@@ -1200,13 +1200,24 @@ void EffectTree::UpdateIsDrawn(EffectNode* node, EffectNode* parent_node) {
   // 3) Nodes that have a backdrop filter.
   // 4) Nodes with animating screen space opacity on main thread or pending tree
   //    are drawn if their parent is drawn irrespective of their opacity.
+  // 5) BrightSign: Nodes whose parent is the root or secondary root of the
+  //    effect tree (i.e. window-level opacity nodes from the browser compositor).
+  //    These must keep compositing/tiling/raster work active so the page is
+  //    ready to display instantly when window opacity is restored.
+  //    CSS element opacity=0 (deeper in the renderer compositor's tree) still
+  //    gets the is_drawn=false optimization as usual.
+  bool is_window_level_node =
+      parent_node &&
+      (parent_node->id == kRootPropertyNodeId ||
+       parent_node->id == kSecondaryRootPropertyNodeId);
   if (node->has_copy_request || node->cache_render_surface ||
       node->subtree_capture_id.is_valid()) {
     node->is_drawn = true;
   } else if (EffectiveOpacity(node) == 0.f &&
              (!node->has_potential_opacity_animation ||
               property_trees()->is_active()) &&
-             node->backdrop_filters.IsEmpty()) {
+             node->backdrop_filters.IsEmpty() &&
+             !is_window_level_node) {
     node->is_drawn = false;
   } else if (parent_node) {
     node->is_drawn = parent_node->is_drawn;
