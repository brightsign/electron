@@ -359,6 +359,27 @@ void WaylandToplevelWindow::SizeConstraintsChanged() {
 void WaylandToplevelWindow::SetOpacity(float opacity) {
   root_surface()->set_opacity(opacity);
   root_surface()->set_blending(true);
+
+  if (opacity > 0.0f)
+    window_hidden_ = false;
+  else
+    window_hidden_ = true;
+
+  // Also immediately commit opacity on the primary subsurface (where actual
+  // content lives). Without this, the subsurface opacity stays stale until
+  // the GPU process submits the next frame.
+  if (auto* subsurface = primary_subsurface()) {
+    auto* surface = subsurface->wayland_surface();
+    surface->set_opacity(opacity);
+    surface->set_blending(true);
+    surface->CommitOpacity();
+  }
+
+  // Commit the root surface LAST. Subsurfaces default to synchronized mode,
+  // meaning their committed state only takes effect when the parent surface
+  // commits. By committing the root after the subsurface, we trigger the
+  // subsurface's pending state to apply immediately.
+  root_surface()->CommitOpacity();
 }
 
