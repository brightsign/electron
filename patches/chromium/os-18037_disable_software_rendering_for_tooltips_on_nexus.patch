From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Tariq Bashir <120014322+t-bashir-bs@users.noreply.github.com>
Date: Thu, 21 Nov 2024 13:46:18 +0000
Subject: OS-18037: Disable software rendering for tooltips on Nexus

Tooltips use software compositing to avoid using unnecessary hardware resources
and as a workaround to an old bug. However, Nexus is missing implementation for
software canvas surfaces and this causes a crash when creating a tooltip. This
patch disables software compositing for tooltips on Nexus, as it works fine and
we can take the small hit on performance, as this isn't a common use case.

diff --git a/ui/base/BUILD.gn b/ui/base/BUILD.gn
index 844ff9140783a95d91cdb9fbdaea304347439525..6ba842eccedfe0922583e13c56ddf78008eb9924 100644
--- a/ui/base/BUILD.gn
+++ b/ui/base/BUILD.gn
@@ -1422,6 +1422,7 @@ buildflag_header("ozone_buildflags") {
   header = "ozone_buildflags.h"
 
   flags = [
+    "IS_OZONE_NEXUS=$ozone_platform_nexus",
     "IS_OZONE_WAYLAND=$ozone_platform_wayland",
     "IS_OZONE_X11=$ozone_platform_x11",
   ]
diff --git a/ui/views/corewm/tooltip_aura.cc b/ui/views/corewm/tooltip_aura.cc
index f447e3dc03c37a51a77f6c304c556dd96f86527c..224d628b40c3257f155f32c93defc4c5fc3f4623 100644
--- a/ui/views/corewm/tooltip_aura.cc
+++ b/ui/views/corewm/tooltip_aura.cc
@@ -18,6 +18,7 @@
 #include "ui/aura/window_tree_host.h"
 #include "ui/base/metadata/metadata_header_macros.h"
 #include "ui/base/metadata/metadata_impl_macros.h"
+#include "ui/base/ozone_buildflags.h"
 #include "ui/base/owned_window_anchor.h"
 #include "ui/base/ui_base_types.h"
 #include "ui/color/color_id.h"
@@ -210,9 +211,11 @@ void TooltipAura::CreateTooltipWidget(const gfx::Rect& bounds,
     params.opacity = views::Widget::InitParams::WindowOpacity::kTranslucent;
   }
   params.shadow_type = views::Widget::InitParams::ShadowType::kNone;
+#if !BUILDFLAG(IS_OZONE_NEXUS)
   // Use software compositing to avoid using unnecessary hardware resources
   // which just amount to overkill for this UI.
   params.force_software_compositing = true;
+#endif
   params.name = kWidgetName;
 
   params.init_properties_container.SetProperty(aura::client::kOwnedWindowAnchor,
diff --git a/ui/views/widget/desktop_aura/desktop_window_tree_host_platform.cc b/ui/views/widget/desktop_aura/desktop_window_tree_host_platform.cc
index 2150c344075c7c66da5bda5e6086ff91ac8da7e2..90bc7d0f10416d7b8b04c4a6fc7ac4dfb51562ee 100644
--- a/ui/views/widget/desktop_aura/desktop_window_tree_host_platform.cc
+++ b/ui/views/widget/desktop_aura/desktop_window_tree_host_platform.cc
@@ -23,6 +23,7 @@
 #include "ui/aura/native_window_occlusion_tracker.h"
 #include "ui/base/hit_test.h"
 #include "ui/base/mojom/window_show_state.mojom.h"
+#include "ui/base/ozone_buildflags.h"
 #include "ui/base/owned_window_anchor.h"
 #include "ui/base/ui_base_features.h"
 #include "ui/base/ui_base_types.h"
@@ -296,10 +297,14 @@ void DesktopWindowTreeHostPlatform::Init(const Widget::InitParams& params) {
 
   CreateAndSetPlatformWindow(std::move(properties));
 
+#if BUILDFLAG(IS_OZONE_NEXUS)
+  CreateCompositor(params.force_software_compositing);
+#else
   // Disable compositing on tooltips as a workaround for
   // https://crbug.com/442111.
   CreateCompositor(params.force_software_compositing ||
                    params.type == Widget::InitParams::TYPE_TOOLTIP);
+#endif
 
   WindowTreeHost::OnAcceleratedWidgetAvailable();
   InitHost();
