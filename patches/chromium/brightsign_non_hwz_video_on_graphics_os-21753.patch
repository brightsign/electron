 void WebMediaPlayerBrightsign::TextureMailboxReadyCallback(
-    const VidPlayerMailboxData& mbox) {}
+    BrightsignTextureFrameInfo info) {
+  DCHECK(main_task_runner_->BelongsToCurrentThread());
+  // A callback queued before teardown must not repopulate state afterwards.
+  if (!vid_player_)
+    return;
+
+  constexpr uint32_t kMaxDim = 8192;
+  // The producer packs rows tightly (stride == width*4); reject anything else
+  // because the frame below is wrapped with a tightly packed layout.
+  if (info.kind != VID_PLAYER_SHMEM || info.width == 0 || info.height == 0 ||
+      info.width > kMaxDim || info.height > kMaxDim || info.slot > 0x7F ||
+      info.stride != info.width * 4) {
+    return;
+  }
+
+  // The slot is now ours; return it to the producer on every early exit until
+  // ownership transfers to the frame's destruction observer below.
+  base::ScopedClosureRunner slot_releaser(base::BindOnce(
+      &WebMediaPlayerBrightsign::ReleaseSlot, weak_this_, info.slot));
+
+  // A mailbox queued before a switch to hwz:on must not overwrite the overlay.
+  if (!video_on_graphics_)
+    return;
+
+  const size_t needed = static_cast<size_t>(info.stride) * info.height;
+
+  auto it = video_shm_maps_.find(info.name);
+  scoped_refptr<ShmMapping> mapping;
+  if (it != video_shm_maps_.end() && it->second->size >= needed) {
+    mapping = it->second;
+  } else {
+    int fd = ::shm_open(info.name.c_str(), O_RDONLY, 0);
+    if (fd < 0) {
+      LOG(ERROR) << "shm_open failed for " << info.name;
+      return;
+    }
+    // mmap can map past the object's end and fault (SIGBUS) on access, so
+    // require the object to actually back |needed| bytes.
+    struct stat st;
+    if (::fstat(fd, &st) != 0 || static_cast<size_t>(st.st_size) < needed) {
+      ::close(fd);
+      LOG(ERROR) << "shm object smaller than frame for " << info.name;
+      return;
+    }
+    void* p = ::mmap(nullptr, needed, PROT_READ, MAP_SHARED, fd, 0);
+    if (p == MAP_FAILED) {
+      ::close(fd);
+      LOG(ERROR) << "mmap failed for " << info.name;
+      return;
+    }
+    // Replacing the cache entry drops our reference to any older mapping;
+    // frames still using it keep it alive via their destruction observer.
+    mapping = base::MakeRefCounted<ShmMapping>(fd, p, needed);
+    video_shm_maps_[info.name] = mapping;
+  }
+
+  // SAFETY: |mapping->ptr| maps at least |needed| readable bytes; the mapping
+  // is kept alive for the frame's lifetime by the destruction observer below.
+  auto data = UNSAFE_BUFFERS(base::span<const uint8_t>(
+      static_cast<const uint8_t*>(mapping->ptr), needed));
+  scoped_refptr<media::VideoFrame> frame = media::VideoFrame::WrapExternalData(
+      media::PIXEL_FORMAT_ARGB, gfx::Size(info.width, info.height),
+      gfx::Rect(info.width, info.height), gfx::Size(info.width, info.height),
+      data, base::TimeDelta());
+  if (!frame) {
+    LOG(ERROR) << "WrapExternalData failed";
+    return;
+  }
+  // The native blit already produced full-range RGB.
+  frame->set_color_space(gfx::ColorSpace::CreateSRGB());
+
+  frame->AddDestructionObserver(base::DoNothingWithBoundArgs(mapping));
+  // Ownership of the ring slot moves to the frame: released once it is dropped.
+  frame->AddDestructionObserver(
+      base::BindPostTask(main_task_runner_, slot_releaser.Release()));
+
+  natural_size_ = gfx::Size(info.width, info.height);
+  if (!video_layer_) {
+    video_layer_ = cc::VideoLayer::Create(this, media::VIDEO_ROTATION_0);
+    client_->SetCcLayer(video_layer_.get());
+  }
+  SetCurrentFrame(frame);
+  compositor_task_runner_->PostTask(
+      FROM_HERE,
+      base::BindOnce(&WebMediaPlayerBrightsign::DidReceiveFrame, weak_this_));
+}
 
