 #include <unistd.h>
+#include <grp.h>
 
 #include <iterator>
 #include <limits>
@@ -438,6 +439,18 @@ Process LaunchProcess(const std::vector<std::string>& argv,
       }
     }
 
+    gid_t gid = 0;
+    if (!options.groups.empty()) {
+      gid = options.groups[0];
+      PCHECK(0 == setgroups(options.groups.size(),options.groups.data()));
+    }
+    if (options.uid > 0)
+      PCHECK(0 == prctl (PR_SET_KEEPCAPS, 1));
+    if (gid > 0)
+      PCHECK(0 == setgid(gid));
+    if (options.uid > 0)
+      PCHECK(0 == setuid(options.uid));
+
     ResetChildSignalHandlersToDefaults();
     SetSignalMask(orig_sigmask);
 
