From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Tariq Bashir <tbashir@brightsign.biz>
Date: Mon, 20 Apr 2026 18:00:38 +0100
Subject: Brightsign: fix semi-transparent window opacity not rendering on
 Nexus platform

SetOpacity() was setting blend equations that referenced ConstantAlpha,
but the actual constant alpha value was never written to the surface
compositor. Additionally, the color blend equation used eOne as the
source multiplier, rendering source color at full strength regardless
of the opacity setting.

Changes:
- Set NEXUS_SurfaceComposition.constantColor via NxClient API so the
  compositor has the actual alpha value for eConstantAlpha blend factor
- Use eConstantAlpha/eInverseConstantAlpha for both color and alpha
  blend equations in the semi-transparent case, matching the pattern
  used by other Nexus applications (nxapps_cmdline)
- Apply the same fix in both Show() and SetOpacity() code paths
- Clamp opacity to [0.0, 1.0] as PlatformWindow::SetOpacity has no
  documented range contract and Widget::SetOpacity only uses DCHECK
- Add nxclient.h include (guarded by SINGLE_PROCESS) for
  NxClient_SetSurfaceClientComposition and NXPL_GetClientID

diff --git a/ui/ozone/platform/nexus/nexus_window.cc b/ui/ozone/platform/nexus/nexus_window.cc
index 229c1298664b068eff1ebd9b7059c6230dadc612..5e2891523ad1af4628cdb9324b58f5765ecfe2f0 100644
--- a/ui/ozone/platform/nexus/nexus_window.cc
+++ b/ui/ozone/platform/nexus/nexus_window.cc
@@ -16,7 +16,9 @@
 #include "ui/ozone/common/bitmap_cursor.h"
 #include "ui/ozone/platform/nexus/nexus_window_manager.h"
 #include "ui/ozone/platform/nexus/nexus_cursor.h"
+#include "nxclient.h"
 
+#include <algorithm>
 #include <string>
 
 #define BS_DEBUG(...) \
@@ -55,6 +57,20 @@ const NEXUS_BlendEquation ShowSourceColor = {
     NEXUS_BlendFactor_eZero
 };
 
+void SetSurfaceClientOpacity(void* native_window, float opacity) {
+  const unsigned client_id = NXPL_GetClientID(native_window);
+  if (client_id == 0) {
+    return;
+  }
+
+  NEXUS_SurfaceComposition comp;
+  NxClient_GetSurfaceClientComposition(client_id, &comp);
+
+  const uint8_t alpha = static_cast<uint8_t>(opacity * 255.0f + 0.5f);
+  comp.constantColor = (static_cast<NEXUS_Pixel>(alpha) << 24) | 0x00FFFFFF;
+  NxClient_SetSurfaceClientComposition(client_id, &comp);
+}
+
 namespace ui {
 
 NexusWindow::NexusWindow(PlatformWindowDelegate* delegate,
@@ -138,14 +154,23 @@ void NexusWindow::Show(bool inactive) {
     };
     win_info.alphaBlend = showSourceAlpha;
   } else {
-    // Partially transparent
-    win_info.colorBlend = ShowSourceColor;
+    // Partially transparent - both color and alpha must use constant alpha
+    NEXUS_BlendEquation blendColor = {
+      NEXUS_BlendFactor_eSourceColor,
+      NEXUS_BlendFactor_eConstantAlpha,
+      false,
+      NEXUS_BlendFactor_eDestinationColor,
+      NEXUS_BlendFactor_eInverseConstantAlpha,
+      false,
+      NEXUS_BlendFactor_eZero
+    };
+    win_info.colorBlend = blendColor;
     NEXUS_BlendEquation blendAlpha = {
       NEXUS_BlendFactor_eSourceAlpha,
       NEXUS_BlendFactor_eConstantAlpha,
       false,
       NEXUS_BlendFactor_eDestinationAlpha,
-      NEXUS_BlendFactor_eInverseSourceAlpha,
+      NEXUS_BlendFactor_eInverseConstantAlpha,
       false,
       NEXUS_BlendFactor_eZero
     };
@@ -153,6 +178,7 @@ void NexusWindow::Show(bool inactive) {
   }
 
   NXPL_UpdateNativeWindowEXT(native_window_, &win_info);
+  SetSurfaceClientOpacity(native_window_, opacity_);
 }
 
 void NexusWindow::Hide() {
@@ -441,6 +467,7 @@ bool NexusWindow::ShouldWindowContentsBeTransparent() const {
 }
 
 void NexusWindow::SetOpacity(float opacity) {
+  opacity = std::clamp(opacity, 0.0f, 1.0f);
   BS_DEBUG( "%s opacity: %f\n", __PRETTY_FUNCTION__, opacity);
   if (opacity > 0.0f)
     visible_ = true;
@@ -473,16 +500,23 @@ void NexusWindow::SetOpacity(float opacity) {
       };
       win_info.alphaBlend = showSourceAlpha;
     } else {
-      // Partially transparent - blend with constant alpha
-      win_info.colorBlend = ShowSourceColor;
-
-      // For alpha blending with opacity: source_alpha * constant_alpha
+      // Partially transparent - both color and alpha must use constant alpha
+      NEXUS_BlendEquation blendColor = {
+        NEXUS_BlendFactor_eSourceColor,
+        NEXUS_BlendFactor_eConstantAlpha,
+        false,
+        NEXUS_BlendFactor_eDestinationColor,
+        NEXUS_BlendFactor_eInverseConstantAlpha,
+        false,
+        NEXUS_BlendFactor_eZero
+      };
+      win_info.colorBlend = blendColor;
       NEXUS_BlendEquation blendAlpha = {
         NEXUS_BlendFactor_eSourceAlpha,
         NEXUS_BlendFactor_eConstantAlpha,
         false,
         NEXUS_BlendFactor_eDestinationAlpha,
-        NEXUS_BlendFactor_eInverseSourceAlpha,
+        NEXUS_BlendFactor_eInverseConstantAlpha,
         false,
         NEXUS_BlendFactor_eZero
       };
@@ -490,6 +524,7 @@ void NexusWindow::SetOpacity(float opacity) {
     }
 
     NXPL_UpdateNativeWindowEXT(native_window_, &win_info);
+    SetSurfaceClientOpacity(native_window_, opacity_);
   }
 }
 
