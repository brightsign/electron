+          replace_with_underlay_hole(quad);
         }
 
         tokens->insert(tokens->end(), child_tokens.begin(), child_tokens.end());
@@ -104,6 +112,7 @@ bool OverlayStrategyUnderlayBrightsign::VideoHoleDraw(
     }
     else if (quad->material == DrawQuad::Material::kVideoHole)
     {
+      auto* video_hole_quad = VideoHoleDrawQuad::MaterialCast(*quad);
       gfx::Rect content_rect;
       BS_DEBUG("OVERLAY: APPLYING UNDERLAY:%d, opacity:%f\n", quad->material, quad->shared_quad_state->opacity * opacity);
       BS_DEBUG("OVERLAY transform: \n %s\n", transform.ToString().c_str());
@@ -116,8 +125,9 @@ bool OverlayStrategyUnderlayBrightsign::VideoHoleDraw(
