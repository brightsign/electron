   auto render_pass = (*render_pass_list)[index].get();
   QuadList& quad_list = render_pass->quad_list;
   bool found_underlay = false;
+  auto replace_with_underlay_hole = [&](auto quad_iterator) {
+    auto* video_hole_quad = VideoHoleDrawQuad::MaterialCast(*quad_iterator);
+    if (video_hole_quad->z_index >= 0) {
+      render_pass->ReplaceExistingQuadWithSolidColor(
+          quad_iterator, SkColors::kTransparent, SkBlendMode::kSrcOver);
+      return;
+    }
+
+    if (!quad_iterator->ShouldDrawWithBlending() &&
+        quad_iterator->shared_quad_state->blend_mode == SkBlendMode::kSrcOver) {
+      render_pass->ReplaceExistingQuadWithSolidColor(
+          quad_iterator, SkColors::kBlack, SkBlendMode::kDstOut);
+      return;
+    }
+
+    render_pass->ReplaceExistingQuadWithSolidColor(
+        quad_iterator, SkColors::kTransparent, SkBlendMode::kSrcOut);
+  };
 
   for (auto quad = quad_list.begin(); quad != quad_list.end(); ++quad) {
     BS_DEBUG("OVERLAY: QUAD MATERIAL:%2d, OPACITY:%f, Location:%s\n",
@@ -82,17 +100,7 @@ bool OverlayStrategyUnderlayBrightsign::VideoHoleDraw(
         for (auto temp_quad : child_tokens) {
           quad = quad_list.InsertAfterAndInvalidateAllPointers<VideoHoleDrawQuad>(
               quad, 1, temp_quad);
-
-          if (VideoHoleDrawQuad::MaterialCast(*quad)->z_index < 0) {
-            if (!quad->ShouldDrawWithBlending() &&
-                quad->shared_quad_state->blend_mode == SkBlendMode::kSrcOver) {
-              render_pass->ReplaceExistingQuadWithSolidColor(quad, SkColors::kBlack,
-                                                             SkBlendMode::kDstOut);
-            } else {
