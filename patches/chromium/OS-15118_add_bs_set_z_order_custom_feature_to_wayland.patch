+    if (!connection->bs_z_order_v1_) {
+      LOG(ERROR) << "Failed to bind to bs_z_order_v1 global";
+      return;
+    }
   } else if (!compositor_ &&
              UNSAFE_TODO(strcmp(interface, "wl_compositor")) == 0) {
     compositor_ = wl::Bind<wl_compositor>(
