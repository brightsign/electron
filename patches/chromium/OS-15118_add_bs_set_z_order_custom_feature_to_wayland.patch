+void XdgToplevel::SetZOrder(ZOrderLevel z_order) {
+  if (connection()->bs_z_order()) {
+    // The z-index we get if we are using xdg on a BS device is an absolute value.
+    bs_z_order_v1_set_z_index(connection()->bs_z_order(), window()->root_surface()->surface(), (int)z_order);
+  }
+}
 }  // namespace ui
