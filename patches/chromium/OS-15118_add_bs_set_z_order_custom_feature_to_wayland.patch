     (*factory_it->second)(this, registry, name, interface, version);
+  } else if (!connection->bs_z_order_v1_ &&
+             UNSAFE_TODO(strcmp(interface, "bs_z_order_v1")) == 0) {
+    connection->bs_z_order_v1_ = wl::Bind<bs_z_order_v1>(
