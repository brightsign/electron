+gfx::Rect WindowTreeHost::GetNonTransformedWindowBounds(const gfx::Rect& new_bounds) {
+  gfx::Rect non_transformed_bounds(new_bounds);
+  gfx::Rect window_bounds = GetBoundsInPixels();
