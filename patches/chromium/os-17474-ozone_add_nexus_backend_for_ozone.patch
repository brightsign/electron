+
+bool NexusWindow::CanDispatchEvent(const PlatformEvent& event) {
+  if (!visible_)
+    return false;
+
+  // If there is an event grabber, only dispatch events to it.
+  gfx::AcceleratedWidget grabber = window_manager_->event_grabber();
+  BS_DEBUG2("%s: %d\n", __PRETTY_FUNCTION__, grabber == widget_);
+  if (grabber != gfx::kNullAcceleratedWidget)
+    return grabber == widget_;
+
+  // Mouse events will always be dispatched to the window under the cursor.
+  if (event->IsLocatedEvent()) {
+    LocatedEvent* located_event = event->AsLocatedEvent();
+    NexusWindow* window_on_mouse =
+        window_manager_->GetWindowAt(located_event->location());
+    return window_on_mouse == this;
+  } else if (event->IsKeyEvent()) {
+    NexusWindow* keyboard_grabber =
+        window_manager_->GetWindow(window_manager_->keyboard_grabber());
+    return keyboard_grabber == this;
+  }
+  return true;
+}
+
+uint32_t NexusWindow::DispatchEvent(const PlatformEvent& event) {
+  BS_DEBUG2("%s: %s\n", title_.c_str(), __PRETTY_FUNCTION__);
+  if (event->IsMouseEvent()) {
+    // If it is mouse button event, set window as keyboard grabber.
+    if (event->AsMouseEvent()->IsAnyButton() && activatable_) {
+      window_manager_->GrabKeyboardEvents(widget_);
+    }
+  } else if (event->IsTouchEvent() && activatable_) {
+    // If it is touch event, set window as keyboard grabber.
+    window_manager_->GrabKeyboardEvents(widget_);
+  }
+
+  if (event->IsLocatedEvent()) {
+    // Make the event location relative to this window's origin.
+    LocatedEvent* located_event = event->AsLocatedEvent();
+
+    if (event->IsMouseEvent()) {
+      NexusWindow* window_on_mouse =
+          window_manager_->GetWindowAt(located_event->location());
+      if (window_on_mouse)
+        window_manager_->MouseOnWindow(window_on_mouse);
+    }
+
+    gfx::PointF location = located_event->location_f();
+    location -= gfx::Vector2dF(bounds_.OffsetFromOrigin());
+    located_event->set_location_f(location);
+    located_event->set_root_location_f(location);
+  }
+
+  bool handled = DispatchEventFromNativeUiEvent(
+      event, base::BindOnce(&PlatformWindowDelegate::DispatchEvent,
+                            base::Unretained(delegate_)));
+
+  return handled ? POST_DISPATCH_STOP_PROPAGATION : POST_DISPATCH_NONE;
+}
+
+void NexusWindow::SetRestoredBoundsInDIP(const gfx::Rect& bounds) {
+  BS_DEBUG( "%s\n", __PRETTY_FUNCTION__);
+}
+
+gfx::Rect NexusWindow::GetRestoredBoundsInDIP() const {
+  BS_DEBUG( "%s\n", __PRETTY_FUNCTION__);
+  return bounds_;
+}
+
+void NexusWindow::SetWindowIcons(const gfx::ImageSkia& window_icon,
+                                const gfx::ImageSkia& app_icon) {
+  BS_DEBUG( "%s\n", __PRETTY_FUNCTION__);
+}
+
+void NexusWindow::SizeConstraintsChanged() {
+  BS_DEBUG( "%s\n", __PRETTY_FUNCTION__);
+}
+
+bool NexusWindow::ShouldWindowContentsBeTransparent() const {
+  BS_DEBUG( "%s\n", __PRETTY_FUNCTION__);
+  return true;
+}
+
+void NexusWindow::SetOpacity(float opacity) {
+  opacity = std::clamp(opacity, 0.0f, 1.0f);
+  BS_DEBUG( "%s opacity: %f\n", __PRETTY_FUNCTION__, opacity);
+  if (opacity > 0.0f)
+    visible_ = true;
+  else
+    visible_ = false;
+
+  opacity_ = opacity;
+
+  // Update the window with new opacity settings
+  if (native_window_) {
+    NXPL_NativeWindowInfoEXT win_info;
+    NXPL_GetNativeWindowInfoEXT(native_window_, &win_info);
+
+    if (!visible_ || opacity_ == 0.0f) {
+      // Hidden or fully transparent
+      win_info.colorBlend = HideSourceColor;
+      win_info.alphaBlend = HideSourceAlpha;
+    } else if (opacity_ == 1.0f) {
+      // Fully opaque
+      win_info.colorBlend = ShowSourceColor;
+      // For alpha, we want: source_alpha * 1.0
+      NEXUS_BlendEquation showSourceAlpha = {
+        NEXUS_BlendFactor_eSourceAlpha,
+        NEXUS_BlendFactor_eOne,
+        false,
+        NEXUS_BlendFactor_eDestinationAlpha,
+        NEXUS_BlendFactor_eInverseSourceAlpha,
+        false,
+        NEXUS_BlendFactor_eZero
+      };
+      win_info.alphaBlend = showSourceAlpha;
+    } else {
+      // Partially transparent - both color and alpha must use constant alpha
+      NEXUS_BlendEquation blendColor = {
+        NEXUS_BlendFactor_eSourceColor,
+        NEXUS_BlendFactor_eConstantAlpha,
+        false,
+        NEXUS_BlendFactor_eDestinationColor,
+        NEXUS_BlendFactor_eInverseConstantAlpha,
+        false,
+        NEXUS_BlendFactor_eZero
+      };
+      win_info.colorBlend = blendColor;
+      NEXUS_BlendEquation blendAlpha = {
+        NEXUS_BlendFactor_eSourceAlpha,
+        NEXUS_BlendFactor_eConstantAlpha,
+        false,
+        NEXUS_BlendFactor_eDestinationAlpha,
+        NEXUS_BlendFactor_eInverseConstantAlpha,
+        false,
+        NEXUS_BlendFactor_eZero
+      };
+      win_info.alphaBlend = blendAlpha;
+    }
+
+    NXPL_UpdateNativeWindowEXT(native_window_, &win_info);
+    SetSurfaceClientOpacity(native_window_, opacity_);
+  }
+}
+
+void NexusWindow::SetZOrderLevel(ZOrderLevel order) {
+  BS_DEBUG( "%s order: %d\n", __PRETTY_FUNCTION__, static_cast<int>(order));
+
+  NXPL_NativeWindowInfoEXT win_info;
+  NXPL_GetNativeWindowInfoEXT(native_window_, &win_info);
+  switch (order) {
+    case ZOrderLevel::kRaise:
+      win_info.roleAction = NEXUS_BrightSignSurfaceAction_eRaise;
+      break;
+    case ZOrderLevel::kLower:
+      win_info.roleAction = NEXUS_BrightSignSurfaceAction_eLower;
+      break;
+    case ZOrderLevel::kRoleGraphics:
+      win_info.role = NEXUS_BrightSignSurfaceRole_eGraphics;
+      break;
+    case ZOrderLevel::kRoleVirtualKeyboard:
+      win_info.role = NEXUS_BrightSignSurfaceRole_eVirtualKeyboard;
+      break;
+    default:
+      break;
+  }
+  NXPL_UpdateNativeWindowEXT(native_window_, &win_info);
+}
+
+}  // namespace ui
