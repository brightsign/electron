+
+void NexusWindow::SetFullscreen(bool fullscreen, int64_t target_display_id) {
+  BS_DEBUG("%s fullscreen: %s\n", __PRETTY_FUNCTION__, fullscreen ? "true" : "false");
+
+  PlatformWindowState new_state = fullscreen ? PlatformWindowState::kFullScreen
+                                             : PlatformWindowState::kNormal;
+
+  if (new_state == state_) {
+    return;  // Already in the requested state
+  }
+
+  previous_state_ = state_;
+  state_ = new_state;
+
+  if (fullscreen) {
+    // Save current bounds for restoration
+    restore_bounds_ = bounds_;
+
+    // Get the display bounds and set window to fullscreen
+    display::Display display = display::Screen::Get()->GetPrimaryDisplay();
+    gfx::Rect display_bounds = display.bounds();
+
+    BS_DEBUG("%s Setting fullscreen bounds: %dx%d+%d+%d\n", __PRETTY_FUNCTION__,
+             display_bounds.width(), display_bounds.height(),
+             display_bounds.x(), display_bounds.y());
+
+    SetBoundsInDIP(display_bounds);
+  } else {
+    // Restore previous bounds
+    BS_DEBUG("%s Restoring bounds: %dx%d+%d+%d\n", __PRETTY_FUNCTION__,
+             restore_bounds_.width(), restore_bounds_.height(),
+             restore_bounds_.x(), restore_bounds_.y());
+
+    SetBoundsInDIP(restore_bounds_);
+  }  // Notify the delegate about the state change
+  if (delegate_) {
+    delegate_->OnWindowStateChanged(previous_state_, state_);
+  }
+}
