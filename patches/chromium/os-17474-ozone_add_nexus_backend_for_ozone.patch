+#include "base/notimplemented.h"
+#include "base/strings/string_util.h"
+#include "base/strings/utf_string_conversions.h"
+#include "build/build_config.h"
+#include "ui/display/screen.h"
+#include "ui/events/event.h"
+#include "ui/events/ozone/evdev/event_factory_evdev.h"
+#include "ui/events/ozone/events_ozone.h"
+#include "ui/events/platform/platform_event_source.h"
+#include "ui/ozone/common/bitmap_cursor.h"
+#include "ui/ozone/platform/nexus/nexus_window_manager.h"
+#include "ui/ozone/platform/nexus/nexus_cursor.h"
+#include "nxclient.h"
+
+#include <algorithm>
+#include <string>
+
+#define BS_DEBUG(...) \
+              do { if (0) fprintf(stderr, ##__VA_ARGS__); } while (0)
+#define BS_DEBUG2(...) \
+              do { if (0) fprintf(stderr, ##__VA_ARGS__); } while (0)
+
+
+const NEXUS_BlendEquation HideSourceColor = {
+    NEXUS_BlendFactor_eSourceColor,
+    NEXUS_BlendFactor_eZero,
+    false,
+    NEXUS_BlendFactor_eDestinationColor,
+    NEXUS_BlendFactor_eOne,
+    false,
+    NEXUS_BlendFactor_eZero
+};
+
+const NEXUS_BlendEquation HideSourceAlpha = {
+    NEXUS_BlendFactor_eSourceAlpha,
+    NEXUS_BlendFactor_eZero,
+    false,
+    NEXUS_BlendFactor_eDestinationAlpha,
+    NEXUS_BlendFactor_eOne,
+    false,
+    NEXUS_BlendFactor_eZero
+};
+
+const NEXUS_BlendEquation ShowSourceColor = {
+    NEXUS_BlendFactor_eSourceColor,
+    NEXUS_BlendFactor_eOne,
+    false,
+    NEXUS_BlendFactor_eDestinationColor,
+    NEXUS_BlendFactor_eInverseSourceAlpha,
+    false,
+    NEXUS_BlendFactor_eZero
+};
+
+void SetSurfaceClientOpacity(void* native_window, float opacity) {
+  const unsigned client_id = NXPL_GetClientID(native_window);
+  if (client_id == 0) {
+    return;
+  }
+
+  NEXUS_SurfaceComposition comp;
+  NxClient_GetSurfaceClientComposition(client_id, &comp);
+
+  const uint8_t alpha = static_cast<uint8_t>(opacity * 255.0f + 0.5f);
+  comp.constantColor = (static_cast<NEXUS_Pixel>(alpha) << 24) | 0x00FFFFFF;
+  NxClient_SetSurfaceClientComposition(client_id, &comp);
+}
+
+namespace ui {
+
+NexusWindow::NexusWindow(PlatformWindowDelegate* delegate,
+                         NexusWindowManager* window_manager,
+                         PlatformWindowInitProperties properties,
+                         EventFactoryEvdev* event_factory,
+                         BrightsignCursorDelegateEvdev* cursor)
+    : delegate_(delegate),
+      bounds_(properties.bounds),
+      event_factory_(event_factory),
+      cursor_(cursor),
+      window_manager_(window_manager),
+      state_(PlatformWindowState::kNormal),
+      previous_state_(PlatformWindowState::kNormal),
+      restore_bounds_(properties.bounds) {
+
+  BS_DEBUG( "%s (%d, %d), %dx%d\n", __PRETTY_FUNCTION__, bounds_.x(), bounds_.y(), bounds_.width(), bounds_.height());
+  NXPL_NativeWindowInfoEXT   win_info;
+  NXPL_GetDefaultNativeWindowInfoEXT(&win_info);
+  win_info.x = bounds_.x();
+  win_info.y = bounds_.y();
+  win_info.width = bounds_.width();
+  win_info.height = bounds_.height();
+  win_info.colorBlend = HideSourceColor;
+  win_info.alphaBlend = HideSourceAlpha;
+
+  // Overlay window types (tooltips, popups, menus) need a role that sorts
+  // above graphics in the Nexus surface compositor's role-based z-ordering.
+  // Without a role they remain as eNone and get stuck behind role-bearing
+  // surfaces like the main graphics window.
+  if (properties.type == PlatformWindowType::kTooltip ||
+      properties.type == PlatformWindowType::kPopup ||
+      properties.type == PlatformWindowType::kMenu) {
+    win_info.role = NEXUS_BrightSignSurfaceRole_eVirtualKeyboard;
+  }
+
+  native_window_ = NXPL_CreateNativeWindowEXT(&win_info);
+
+  activatable_ = properties.activatable;
+
+  widget_ = window_manager_->AddWindow(this);
+  delegate->OnAcceleratedWidgetAvailable(widget_);
+
+  if (PlatformEventSource::GetInstance())
+    PlatformEventSource::GetInstance()->AddPlatformEventDispatcher(this);
+
+  if (activatable_) {
+    window_manager_->GrabKeyboardEvents(widget_);
+  }
+}
+
+NexusWindow::~NexusWindow() {
+  if (PlatformEventSource::GetInstance())
+    PlatformEventSource::GetInstance()->RemovePlatformEventDispatcher(this);
+  if (widget_ != gfx::kNullAcceleratedWidget) {
+    window_manager_->RemoveWindow(widget_, this);
+    widget_ = gfx::kNullAcceleratedWidget;
+  }
+}
+
+
+void NexusWindow::Show(bool inactive) {
+  BS_DEBUG2( "%s: title:%s visible:%d opacity:%f\n", __PRETTY_FUNCTION__, title_.c_str(), visible_, opacity_);
+  visible_ = true;
+  NXPL_NativeWindowInfoEXT   win_info;
+  NXPL_GetNativeWindowInfoEXT(native_window_, &win_info);
+
+  // Respect current opacity - if SetOpacity(0) was called before Show(),
+  // keep the window hidden rather than overwriting with ShowSourceColor.
+  if (opacity_ == 0.0f) {
+    win_info.colorBlend = HideSourceColor;
+    win_info.alphaBlend = HideSourceAlpha;
+  } else if (opacity_ == 1.0f) {
+    // Fully opaque
+    win_info.colorBlend = ShowSourceColor;
+    NEXUS_BlendEquation showSourceAlpha = {
+      NEXUS_BlendFactor_eSourceAlpha,
+      NEXUS_BlendFactor_eOne,
+      false,
+      NEXUS_BlendFactor_eDestinationAlpha,
+      NEXUS_BlendFactor_eInverseSourceAlpha,
+      false,
+      NEXUS_BlendFactor_eZero
+    };
+    win_info.alphaBlend = showSourceAlpha;
+  } else {
+    // Partially transparent - both color and alpha must use constant alpha
+    NEXUS_BlendEquation blendColor = {
+      NEXUS_BlendFactor_eSourceColor,
+      NEXUS_BlendFactor_eConstantAlpha,
+      false,
+      NEXUS_BlendFactor_eDestinationColor,
+      NEXUS_BlendFactor_eInverseConstantAlpha,
+      false,
+      NEXUS_BlendFactor_eZero
+    };
+    win_info.colorBlend = blendColor;
+    NEXUS_BlendEquation blendAlpha = {
+      NEXUS_BlendFactor_eSourceAlpha,
+      NEXUS_BlendFactor_eConstantAlpha,
+      false,
+      NEXUS_BlendFactor_eDestinationAlpha,
+      NEXUS_BlendFactor_eInverseConstantAlpha,
+      false,
+      NEXUS_BlendFactor_eZero
+    };
+    win_info.alphaBlend = blendAlpha;
+  }
+
+  NXPL_UpdateNativeWindowEXT(native_window_, &win_info);
+  SetSurfaceClientOpacity(native_window_, opacity_);
+}
+
+void NexusWindow::Hide() {
+  BS_DEBUG2( "%s: title:%s visible:%d opacity:%f\n", __PRETTY_FUNCTION__, title_.c_str(), visible_, opacity_);
+  visible_ = false;
+  NXPL_NativeWindowInfoEXT   win_info;
+  NXPL_GetNativeWindowInfoEXT(native_window_, &win_info);
+  win_info.colorBlend = HideSourceColor;
+  win_info.alphaBlend = HideSourceAlpha;
+  NXPL_UpdateNativeWindowEXT(native_window_, &win_info);
+}
+
+void NexusWindow::Close() {
+  BS_DEBUG( "%s\n", __PRETTY_FUNCTION__);
+  if (widget_ != gfx::kNullAcceleratedWidget) {
+    window_manager_->RemoveWindow(widget_, this);
+    widget_ = gfx::kNullAcceleratedWidget;
+  }
+  NXPL_DestroyNativeWindow(native_window_);
+  delegate_->OnClosed();
+}
+
+
+bool NexusWindow::IsVisible() const {
+  bool result = visible_ && opacity_ > 0.0f;
+  BS_DEBUG2( "%s: title:%s visible:%d opacity:%f result:%d\n", __PRETTY_FUNCTION__, title_.c_str(), visible_, opacity_, result);
+  return result;
+}
