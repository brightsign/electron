From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Tariq Bashir <120014322+t-bashir-bs@users.noreply.github.com>
Date: Tue, 11 Jun 2024 15:55:18 +0100
Subject: launcher: Set supplementary groups for renderer process

OS-17053 OS-22521. Cherry picked changes from QTWebEngine to allow setting the supplementary
groups of the renderer process, so renderers can run with fewer groups than
the browser (BrightSign keeps the NSS database group out of renderers).

The groups come from the browser context (GetGroupsForRenderer, filled from
the --renderer-process-gids switch) and are applied in the child before exec
when a renderer is launched directly, or by the zygote after fork. Changing
groups needs CAP_SETGID: the launcher raises it as an ambient capability for
the zygote only, the zygote drops every capability in the renderer after
setgroups, and a directly launched renderer sheds CAP_SETGID once its groups
are set. The uid is not changed and capabilities are not retained
(OS-22518), unlike the original change.

diff --git a/base/process/launch.h b/base/process/launch.h
index 59eac5dc8c61b5c2df58d467149d4f3a9936611d..63b10c2eb4e1791fc1ac35c4fc4b2d924f065965 100644
--- a/base/process/launch.h
+++ b/base/process/launch.h
@@ -248,6 +248,13 @@ struct BASE_EXPORT LaunchOptions {
   // Sets parent process death signal to SIGKILL.
   bool kill_on_parent_death = false;
 
+  // Supplementary groups to set in the child (empty = don't change). OS-22521.
+  std::vector<gid_t> groups;
+
+  // Raise CAP_SETGID as an ambient capability in the child so it survives
+  // exec. Best effort; Linux only. OS-22521.
+  bool ambient_setgid = false;
+
   // File descriptors of the parent process with FD_CLOEXEC flag to be removed
   // before calling exec*().
   std::vector<int> fds_to_remove_cloexec;
diff --git a/base/process/launch_posix.cc b/base/process/launch_posix.cc
index f859dcb1d24f68fa92aff9cf58ac72c10eddc9cc..d164d1ab06bd84a642ac61b3b96365c5117aa3d8 100644
--- a/base/process/launch_posix.cc
+++ b/base/process/launch_posix.cc
@@ -19,6 +19,7 @@
 #include <sys/types.h>
 #include <sys/wait.h>
 #include <unistd.h>
+#include <grp.h>
 
 #include <iterator>
 #include <limits>
@@ -46,6 +47,7 @@
 #include "build/build_config.h"
 
 #if BUILDFLAG(IS_LINUX) || BUILDFLAG(IS_CHROMEOS) || BUILDFLAG(IS_AIX)
+#include <linux/capability.h>
 #include <sys/prctl.h>
 #endif
 
@@ -447,6 +449,29 @@ Process LaunchProcess(const std::vector<std::string>& argv,
     // an arbitrarily high number. See https://crbug.com/539567
     base::IncreaseFdLimitTo(8192);
 
+    // Reduce supplementary groups in the child (renderer). OS-22521.
+    if (!options.groups.empty())
+      PCHECK(0 == setgroups(options.groups.size(), options.groups.data()));
+
+#if BUILDFLAG(IS_LINUX) || BUILDFLAG(IS_CHROMEOS)
+    if (!options.groups.empty()) {
+      // The groups are set; the exec'd child must not keep CAP_SETGID.
+      struct __user_cap_header_struct header = {_LINUX_CAPABILITY_VERSION_3, 0};
+      struct __user_cap_data_struct data[2];
+      PCHECK(0 == syscall(SYS_capget, &header, data));
+      const uint32_t keep = ~(1u << CAP_SETGID);
+      data[0].effective &= keep;
+      data[0].permitted &= keep;
+      data[0].inheritable &= keep;
+      PCHECK(0 == syscall(SYS_capset, &header, data));
+    }
+
+    // Needs CAP_SETGID in both the permitted and inheritable sets; ignore
+    // failure so builds without the capability still launch. OS-22521.
+    if (options.ambient_setgid)
+      prctl(PR_CAP_AMBIENT, PR_CAP_AMBIENT_RAISE, CAP_SETGID, 0, 0);
+#endif
+
     ResetChildSignalHandlersToDefaults();
     SetSignalMask(orig_sigmask);
 
