+      auto agg_transform =
+          transform * agg_quad->shared_quad_state->quad_to_target_transform;
+      auto agg_opacity = opacity * agg_quad->shared_quad_state->opacity;
+
+      size_t search_index = index;
+      while (search_index > 0) {
