-                                   base::Unretained(delegate_)));
-  return ui::POST_DISPATCH_STOP_PROPAGATION;
+                            base::Unretained(delegate_)));
+
+  return handled ? POST_DISPATCH_STOP_PROPAGATION : POST_DISPATCH_NONE;
 }
 
