@@ -649,6 +650,14 @@ base::ProcessId Zygote::ReadArgsAndFork(base::PickleIterator iter,
       PCHECK(0 == prctl(PR_SET_NO_NEW_PRIVS, 1, 0, 0, 0));
       CHECK(setuid(0) != 0);
     }
+
+    // We use quite a few file descriptors for our IPC as well as disk the disk
+    // cache, and the default limit on Apple is low (256), so bump it up.
+    // Same for Linux. The default various per distro, but it is 1024 on Fedora.
