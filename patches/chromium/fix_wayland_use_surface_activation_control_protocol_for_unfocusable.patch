@@ -0,0 +1,100 @@
+<?xml version="1.0" encoding="UTF-8"?>
+<protocol name="surface_activation_unstable_v1">
+  <copyright>
+    Copyright © 2025 BrightSign LLC
+
+    Permission is hereby granted, free of charge, to any person obtaining a
