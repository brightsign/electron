+    FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER
+    DEALINGS IN THE SOFTWARE.
+  </copyright>
+
+  <description summary="Protocol for controlling surface activation behavior">
+    This protocol allows clients to control whether their surfaces should
+    automatically receive input focus when they are mapped or updated.
+
+    This is particularly useful for media players and other applications
+    that should not steal focus from other applications when they start
+    playing content or when they update their content.
+
+    Warning! The protocol described in this file is experimental and backward
+    incompatible changes may be made. Backward compatible changes may be added
+    together with the corresponding interface version bump. Backward
+    incompatible changes are done by bumping the version number in the protocol
+    and interface names and resetting the interface version. Once the protocol
+    is to be declared stable, the 'z' prefix and the version number in the
+    protocol and interface names are removed and the interface version number is
+    reset.
+  </description>
+
+  <interface name="zwp_surface_activation_control_manager_v1" version="1">
+    <description summary="manager for activation control">
+      This interface allows clients to create activation control objects
+      for their surfaces.
+    </description>
+
+    <request name="get_activation_control">
+      <description summary="create an activation control object for a surface">
+        Create an activation control object for the given surface.
+        This allows the client to control whether the surface should
+        automatically receive focus.
+      </description>
+      <arg name="id" type="new_id" interface="zwp_surface_activation_control_v1"/>
+      <arg name="surface" type="object" interface="wl_surface"/>
+    </request>
+
+    <request name="destroy" type="destructor">
+      <description summary="destroy the manager">
+        Destroy the activation control manager. This does not affect
+        any existing activation control objects.
+      </description>
+    </request>
+  </interface>
+
+  <interface name="zwp_surface_activation_control_v1" version="1">
+    <description summary="control activation behavior of a surface">
+      This interface allows a client to control whether a surface should
+      automatically receive input focus when it is mapped or when certain
+      events occur.
+    </description>
+
+    <request name="set_no_activate">
+      <description summary="prevent surface from automatically receiving focus">
+        Prevent this surface from automatically receiving input focus.
+        The surface can still be focused manually by the user or compositor,
+        but it will not steal focus when mapped or updated.
+
+        This setting persists until explicitly changed or the surface is destroyed.
+      </description>
+    </request>
+
+    <request name="set_activate_normal">
+      <description summary="restore normal activation behavior">
+        Restore normal activation behavior for this surface.
+        The surface will behave according to the compositor's default
+        focus policy.
+      </description>
+    </request>
+
+    <request name="destroy" type="destructor">
+      <description summary="destroy the activation control object">
+        Destroy the activation control object. The surface will revert
+        to normal activation behavior.
+      </description>
+    </request>
+  </interface>
+</protocol>
